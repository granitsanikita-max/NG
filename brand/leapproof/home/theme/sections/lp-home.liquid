<script>
(function(){
  /* SAMPLE tester cards only with ?lpdemo=1 (mockup; FTC: no invented reviews live) */
  try{ if(new URLSearchParams(location.search).get('lpdemo')==='1'){ var t=document.getElementById('lph-testers'); if(t) t.hidden=false; } }catch(e){}
  /* sticky CTA: on whenever the hero button is off screen (small phones too), off at the final CTA */
  var s=document.getElementById('lph-sticky'), heroBtn=document.querySelector('#lph .lph-hero .lph-btn'), fin=document.querySelector('#lph .lph-final');
  if(!s||!heroBtn||!('IntersectionObserver' in window)) return;
  var pastHero=false, atEnd=false;
  function upd(){ var on=pastHero&&!atEnd; s.classList.toggle('on',on); s.setAttribute('aria-hidden',on?'false':'true'); s.querySelector('a').tabIndex=on?0:-1; }
  new IntersectionObserver(function(e){ pastHero=!e[0].isIntersecting; upd(); }).observe(heroBtn);
  if(fin) new IntersectionObserver(function(e){ atEnd=e[0].isIntersecting; upd(); }).observe(fin);
})();
</script>

