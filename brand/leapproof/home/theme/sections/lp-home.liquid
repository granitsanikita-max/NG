    { "type": "text", "id": "checkout_url", "label": "Checkout link (no query string)", "default": "https://leapproof.myfunnelish.com/checkout-page-189927362748349459546632494-1791612140332612" },
    { "type": "checkbox", "id": "show_sample_reviews", "label": "Show SAMPLE tester cards (needs ?lpdemo=1)", "info": "Mockup only. Turn off or replace with real reviews before launch.", "default": false }
